SHIFT_DB=sqlite:///./shift.db
# Local use only. Start scripts bind to 127.0.0.1.

# Optional AI condition parsing. These values are read from server environment.
# No external requests occur without a user-confirmed AI preview action.
# OPENAI_API_KEY=
# SHIFT_AI_MODEL=your-structured-output-capable-model

# Cloudflare free preview: see docs/CLOUDFLARE_FREE.md. Never commit live secrets.
# SHIFT_ENV=production
# SHIFT_PUBLIC_ORIGIN=https://your-public-host
# SHIFT_DB=sqlite:///C:/path/to/private/shift.db
# SHIFT_PLATFORM_DB=sqlite:///C:/path/to/private/platform.db
# SHIFT_TENANT_ROOT=C:/path/to/private/tenants
# SHIFT_AUTH_SECRET=generate-at-least-32-random-characters
# SHIFT_SETUP_TOKEN=generate-at-least-32-random-characters
# SHIFT_PLATFORM_SETUP_TOKEN=generate-at-least-32-random-characters
# SHIFT_SMTP_HOST=smtp.gmail.com
# SHIFT_SMTP_PORT=465
# SHIFT_SMTP_USER=sender@gmail.com
# SHIFT_SMTP_PASSWORD=
# SHIFT_MAIL_FROM=sender@gmail.com
